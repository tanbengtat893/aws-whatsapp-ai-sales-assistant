# Copy this file to .env and adjust values as needed.

# Server port
PORT=3000

# Location of the JSON/SQLite data store
DATA_DIR=./data

# WhatsApp integration mode: "simulated" (no external API) or "cloud" (real WhatsApp Business Cloud API)
WHATSAPP_MODE=simulated

# Language detection: below this confidence, default to English
LANG_MIN_CONFIDENCE=0.5

# FAQ matching: below this confidence, escalate to a human rep
FAQ_MIN_CONFIDENCE=0.6

# --- WhatsApp Cloud API (only used when WHATSAPP_MODE=cloud; phase 2) ---
# WHATSAPP_TOKEN=
# WHATSAPP_PHONE_NUMBER_ID=
# WHATSAPP_VERIFY_TOKEN=

# --- AI intent understanding (Task 15, server only) ---
# Set to true ONLY on the Lightsail server where the OpenClaw gateway runs.
# Leave off locally/in tests; the deterministic matcher is used as fallback.
USE_OPENCLAW=false
# Path to the openclaw binary (default: openclaw on PATH)
# OPENCLAW_BIN=openclaw
# Max time to wait for an AI intent extraction before falling back (ms)
OPENCLAW_TIMEOUT_MS=20000
